{
  "name": "templatehub-api",
  "version": "1.0.0",
  "description": "TemplateHub - Remote template service for Sumaiya",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "deploy": "next build && next start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest tests/integration",
    "migrate": "psql $DATABASE_URL -f scripts/migrate.sql",
    "seed": "ts-node scripts/seed.ts",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "postgres": "^3.4.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.1.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
