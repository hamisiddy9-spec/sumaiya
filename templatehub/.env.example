# Database
DATABASE_URL=postgresql://templatehub:templatehub@localhost:5432/templatehub
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Authentication
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY=24h
TEMPLATEHUB_API_KEY=dev-api-key-change-in-production

# Rendering
PUPPETEER_HEADLESS=true
FONT_CACHE_DIR=/tmp/fonts

# Sumaiya Integration
SUMAIYA_API_URL=http://localhost:3000
SUMAIYA_WEBHOOK_SECRET=webhook-secret-here

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Storage (S3 or similar for exports)
STORAGE_BUCKET=templatehub-exports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
