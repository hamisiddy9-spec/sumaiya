{
  "name": "sumaiya",
  "private": true,
  "version": "0.0.0",
  "description": "Sumaiya — get hired with AI. Monorepo: web (Next.js) + native (Expo) + shared packages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "npm run dev -w @sumaiya/web",
    "native": "npm -C apps/native run start",
    "web:dev": "npm -w @sumaiya/web run dev",
    "web:build": "npm -w @sumaiya/web run build",
    "web:typecheck": "npm -w @sumaiya/web run typecheck",
    "web:test": "npm -w @sumaiya/web run test",
    "native:typecheck": "npm -C apps/native run typecheck",
    "native:test": "npm -C apps/native run test",
    "native:export": "npm -C apps/native run export",
    "native:install": "npm -C apps/native install",
    "seam": "node scripts/seam/run.mjs",
    "seam:http-only": "node scripts/seam/run.mjs --http-only",
    "seam:skip-evals": "node scripts/seam/run.mjs --skip-evals",
    "whatsapp": "npm -C apps/whatsapp start",
    "whatsapp:test": "npm -C apps/whatsapp test",
    "assert:rls": "node scripts/assert-rls.mjs"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}