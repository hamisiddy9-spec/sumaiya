# Release signing material — NEVER commit these.
# The debug keystore below stays tracked (it is public by design and only ever
# used for debug builds); the release key is what protects user updates.
apps/native/android/keystore.properties
apps/native/android/app/sumaiya-release.keystore
*.jks
*.keystore.bak

# agent run artefacts (print-mode JSON + stderr from delegated runs)
.*-run.json
.*-run.err

# free-improve-loop local state (queue, logs, flags) — not committed, changes hourly
docs/panels/.loop/

# Generated render output. Regenerable; keeping it out of the tree stops it appearing
# in every git status and in every commit that stages too broadly.
docs/template-renders/
