# Copy to .env for local / Expo CLI builds.
#
# .env itself is git-ignored, so this file is the tracked documentation of what
# the app's environment is supposed to contain. The canonical host lives in
# src/lib/app-hosts.ts; this mirrors it for tooling that reads env directly.
#
# The apex, not www — www.sumaiya.app 308-redirects to the apex, so pointing the
# app there would put a redirect in front of every API call.
EXPO_PUBLIC_API_URL=https://sumaiya.app

# Sentry — crash & error monitoring. Create a React Native project at
# sentry.io and paste its DSN. Leave unset to disable reporting (SDK stays
# wired, ingests nothing).
EXPO_PUBLIC_SENTRY_DSN=
