<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup / device-transfer configuration.

     AsyncStorage's Android database (RKStorage, or "AsyncStorage" on the
     newer storage engine) holds the Supabase session — access_token and
     refresh_token — alongside low-value caches (chat history, telemetry
     queue, course progress, a pending photo). Restoring that database after
     a reinstall or a device migration would silently sign the app back in
     with a live token on a device the user never authenticated on.

     The user's actual documents (CVs) live in a separate database
     (sumaiya.db, expo-sqlite) and are deliberately NOT excluded here — they
     stay backed up. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="database" path="RKStorage"/>
    <exclude domain="database" path="RKStorage-journal"/>
    <exclude domain="database" path="RKStorage-wal"/>
    <exclude domain="database" path="RKStorage-shm"/>
    <exclude domain="database" path="AsyncStorage"/>
    <exclude domain="database" path="AsyncStorage-journal"/>
    <exclude domain="database" path="AsyncStorage-wal"/>
    <exclude domain="database" path="AsyncStorage-shm"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="database" path="RKStorage"/>
    <exclude domain="database" path="RKStorage-journal"/>
    <exclude domain="database" path="RKStorage-wal"/>
    <exclude domain="database" path="RKStorage-shm"/>
    <exclude domain="database" path="AsyncStorage"/>
    <exclude domain="database" path="AsyncStorage-journal"/>
    <exclude domain="database" path="AsyncStorage-wal"/>
    <exclude domain="database" path="AsyncStorage-shm"/>
  </device-transfer>
</data-extraction-rules>
