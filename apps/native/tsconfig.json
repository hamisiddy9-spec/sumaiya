{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "lib": ["es2021", "dom"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "baseUrl": ".",
    // The @sumaiya/* packages are file:-linked into node_modules/@sumaiya/*.
    // preserveSymlinks makes tsc resolve their imports (react, expo-sqlite,
    // @sumaiya/types) from THIS app's node_modules — where React 19 / Expo 57
    // live — instead of walking up the packages/ realpath and missing them.
    "preserveSymlinks": true
  },
  "include": ["src", "nativewind-env.d.ts", "*.ts", "*.tsx"],
  "exclude": ["node_modules", "dist", ".expo", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
