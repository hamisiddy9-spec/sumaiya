{
  "expo": {
    "name": "Sumaiya",
    "slug": "sumaiya",
    "version": "1.6.12",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sumaiya",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DA4A1C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.sumaiya.app"
    },
    "android": {
      "package": "pro.sumaiya.app",
      "versionCode": 10612,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DA4A1C"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "sumaiya"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sumaiya.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/with-release-signing",
      "expo-font",
      "expo-sharing",
      "expo-camera",
      "expo-image-picker",
      "expo-document-picker",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#DA4A1C"
        }
      ]
    ]
  }
}
