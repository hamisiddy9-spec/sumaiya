# =============================================
# Sumaiya — Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETPLACE_ENABLED="false"

# --- Rate limiting (optional, recommended for production) ---
# Without these, rate limiting falls back to an in-memory limiter that only
# throttles within a single serverless instance. Set both to enforce per-IP
# limits across all instances via Upstash Redis (REST — no persistent socket).
# Create a free database at https://upstash.com → REST API section.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Use the Supabase Transaction mode pooler (port 6543) — required for Vercel serverless.
# Find it in: Supabase Dashboard → Settings → Database → Connection string → "Transaction" mode
DATABASE_URL="postgresql://postgres.your-project-ref:***@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# --- Google OAuth ---
# Web sign-in uses Google Identity Services IN THE BROWSER (an ID token minted by
# Google, verified by Supabase via signInWithIdToken). It therefore needs only the
# PUBLIC client ID, and NOTHING here needs the client secret — the Supabase
# provider can stay without one. See apps/web/lib/google-identity.ts.
# If unset, lib/google-identity.ts falls back to the Web client ID the native app
# already ships, so the button works with no env change at all.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="811013224847-xxxx.apps.googleusercontent.com"
# Server-side only (OG image, admin tooling). NEVER a NEXT_PUBLIC_ var.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Supabase-hosted OAuth only — not needed by the web app any more.
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Payments (PayMe Africa) ---
# Live charging also requires PAYMENTS_ENABLED=true (server) and
# NEXT_PUBLIC_PAYMENTS_ENABLED=true (UI). Both default off.
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
PAYME_APP_ID="your-app-id"
PAYME_APP_SECRET="your-app-secret"
PAYME_SANDBOX="1"                 # "1" for sandbox, unset/empty for production
# PAYME_BASE_URL=                 # override only if PayMe changes the API host
PAYME_CALLBACK_URL="http://localhost:3000/api/payments/callback"
PAYME_REDIRECT_URL="http://localhost:3000/checkout/success"

# --- Email (Resend) ---
RESEND_API_KEY="your-resend-api-key"
# The display name is user-visible in every outbound mail, so it must say
# Sumaiya. The address stays on templatehub.pro on purpose: sumaiya.app has no
# MX records yet, and this matches the code's own default in lib/email.ts.
EMAIL_FROM="Sumaiya <noreply@templatehub.pro>"

# --- AI (for AI Enhance feature) ---
# Primary provider (checked first): DeepSeek
DEEPSEEK_API_KEY="your-deepseek-api-key"
# Fallback providers (used if DeepSeek is not configured):
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# --- AI limits and cost ceilings ---
# All of these have defaults in code; they are listed because each one decides
# how much a stranger can spend on your provider key, and an unset one is
# indistinguishable from a deliberate one.
#
# Signed-in users: burst per minute, and calls per day (defaults 10 and 60).
# Enforced in lib/api/ai-limit.ts, on top of the per-user monthly ceiling below.
# AI_PER_MINUTE="10"
# AI_PER_DAY="60"
#
# Signed-out guests: AI calls per day, per IP (default 200). Deliberately
# generous, because East-African carriers put many users behind one NAT IP and
# a low cap would lock out legitimate guests who share it. Note the asymmetry:
# a guest gets a share of that 200, a signed-in user gets 60 of their own.
# GUEST_AI_PER_DAY="200"
#
# Per-user monthly AI spend ceiling in USD, estimated from the tool_invocation
# audit trail. OFF unless set to a number. It cannot cover guests — a per-user
# cap has no user to charge — which is why GUEST_AI_PER_DAY exists.
# AI_USER_MONTHLY_USD="1"

# --- Anti-fabrication eval sampling (nightly job) ---
# Fraction of generative tool calls sampled for the nightly verdict pass
# (default 0.05), and the flag rate at which that job reports a regression
# (default 0.15). At 0.05 a quiet day legitimately produces zero samples —
# "No pending eval samples" is not by itself evidence that quality is fine.
# EVAL_SAMPLE_RATE="0.05"
# EVAL_FLAG_RATE_ALARM="0.15"

# --- Ops alerts ---
# Bearer secret shared by the /api/cron/* routes and whatever calls them: the
# caller sends it, the route rejects anything else.
CRON_SECRET="generate-a-long-random-string"
# Where /api/cron/health emails when a component (AI provider, DB) fails.
# ALERT_EMAIL="you@example.com"
# Who may reach the admin-only routes.
# ADMIN_EMAILS="you@example.com"


# --- E2E smoke tests (Browserbase, optional) ---
# Used only by `npm run test:e2e` to drive the deployed app in a real cloud
# browser. Get these at app.browserbase.com. Not needed to run the app.
BROWSERBASE_API_KEY="bb_..."
BROWSERBASE_PROJECT_ID="your-browserbase-project-id"

# --- Jobs aggregation engine: key-gated sources (PR-4) ---
# Each source is SKIPPED (enabled()=false) until its key is configured —
# ingest keeps working with whatever IS configured. No scraping of
# LinkedIn/Indeed/Glassdoor/ZipRecruiter/Monster — official APIs + ATS boards only.

# Adzuna (https://developer.adzuna.com/ — free tier)
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_API_KEY="your-adzuna-api-key"
# ADZUNA_COUNTRY="us"   # us | gb | de | in | ng …

# Jooble (https://jooble.org/api/about — free tier)
JOOBLE_API_KEY="your-jooble-api-key"

# USAJOBS (https://developer.usajobs.gov/ — free, US government data)
USAJOBS_API_KEY="your-usajobs-api-key"
USAJOBS_EMAIL="you@example.com"   # registered email — sent as User-Agent (required)
# USAJOBS_KEYWORD="engineer"

# Careerjet (https://www.careerjet.com/partners/api/)
CAREERJET_API_KEY="your-careerjet-api-key"
CAREERJET_AFFILIATE_ID="your-careerjet-affiliate-id"
# CAREERJET_LOCALE="en_GB"

# Talent.com (https://www.talent.com/en/partners/api)
TALENT_PUBLISHER_ID="your-talent-publisher-id"
TALENT_API_KEY="your-talent-api-key"
# TALENT_QUERY="software engineer"

# --- Jobs aggregation engine: keyless ATS boards (PR-4) ---
# Greenhouse board tokens (jobs at greenhouse.io/<token>). Defaults to live
# public boards; override with your own list.
# GREENHOUSE_BOARDS="affirm,airbnb,duolingo"
# Lever company slugs (path of jobs.lever.co/<slug>). DISABLED until set —
# the public demo board only carries fictional postings (anti-fabrication).
# LEVER_COMPANIES=""
# SmartRecruiters company identifiers (api.smartrecruiters.com/v1/companies/<id>).
# SMARTRECRUITERS_COMPANIES="Hootsuite"
