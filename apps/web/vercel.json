{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/follow-ups", "schedule": "0 8 * * *" },
    { "path": "/api/cron/jobs", "schedule": "0 6 * * *" },
    { "path": "/api/cron/health", "schedule": "0 */6 * * *" }
  ]
}
