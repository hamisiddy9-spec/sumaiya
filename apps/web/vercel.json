{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "templatehub.pro" }],
      "destination": "/pro"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.templatehub.pro" }],
      "destination": "/pro"
    }
  ],
  "crons": [
    { "path": "/api/cron/jobs", "schedule": "0 6 * * *" },
    { "path": "/api/cron/signals", "schedule": "0 7 * * *" },
    { "path": "/api/cron/follow-ups", "schedule": "0 8 * * *" }
  ]
}
