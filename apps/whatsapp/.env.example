# Sumaiya WhatsApp worker — copy to .env and fill in.
PORT=8080

# From the Meta app -> WhatsApp -> Configuration. You choose the verify token.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# Meta app -> WhatsApp -> API Setup. Use a permanent System User token in prod.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# The deployed Sumaiya web app.
SUMAIYA_API_URL=https://sumaiya.pro

# Must be identical to WHATSAPP_WORKER_SECRET set on the web app.
WHATSAPP_WORKER_SECRET=

# Optional
GRAPH_VERSION=v21.0
